{
  "name": "Scrum Master MCP Toolkit",
  "dockerComposeFile": "docker-compose.dev.yml",
  "service": "workspace",
  "workspaceFolder": "/workspace",
  "shutdownAction": "stopCompose",

  // Install Deno, Node/npm, and gh CLI as devcontainer features.
  // uv and Python are bootstrapped in postCreateCommand via the official uv installer.
  "features": {
    "ghcr.io/devcontainers-extra/features/deno:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/docker-in-docker:3": {
      "moby": false
    },
    "ghcr.io/devcontainers-extra/features/act:1": {}
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "denoland.vscode-deno",
        "ms-azuretools.vscode-docker",
        "mikestead.dotenv",
        "redhat.vscode-yaml",
        "ZainChen.json",
        "esbenp.prettier-vscode",
        "GitHub.vscode-pull-request-github",
        "streetsidesoftware.code-spell-checker",
        "pomdtr.excalidraw-editor",
        "zoocodeorganization.zoo-code",
        "GraphQL.vscode-graphql-syntax",
        "ms-azuretools.vscode-containers",
        "github.vscode-github-actions",
        "bpruitt-goddard.mermaid-markdown-syntax-highlighting",
        "jebbs.plantuml"
      ],
      "settings": {
        // Deno as the default TypeScript/JavaScript language server
        "deno.enable": true,
        "deno.lint": true,
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "denoland.vscode-deno",
        "[typescript]": {
          "editor.defaultFormatter": "denoland.vscode-deno"
        },
        "[javascript]": {
          "editor.defaultFormatter": "denoland.vscode-deno"
        },

        // Terminal shell
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },

  "forwardPorts": [3000, 6274, 6277, 6333, 6334, 8080, 9229],
  "portsAttributes": {
    "3000": {
      "label": "MCP Server",
      "onAutoForward": "notify"
    },
    "6333": {
      "label": "Qdrant HTTP API",
      "onAutoForward": "silent"
    },
    "6334": {
      "label": "Qdrant gRPC",
      "onAutoForward": "silent"
    },
    "8080": {
      "label": "SearXNG",
      "onAutoForward": "silent"
    },
    "6274": { "label": "MCP Inspector UI", "onAutoForward": "openBrowser" },
    "6277": { "label": "MCP Inspector Proxy" },
    "9229": { "label": "Node.js Debugger" }
  },

  "remoteEnv": {
    "PATH": "${containerEnv:PATH}:/home/vscode/.local/bin",
    "QDRANT_URL": "http://vectordb:6333",
    "QDRANT_GRPC_URL": "http://vectordb:6334",
    "MEMPALACE_WING": "workspace"
  },

  // 1. Install uv (official installer) + Python 3.12 managed by uv
  // 2. Install mempalace for AI memory tooling
  // 3. Cache Deno dependencies declared in deno.json
  "postCreateCommand": "bash .devcontainer/post-create.sh",

  "remoteUser": "vscode"
}
