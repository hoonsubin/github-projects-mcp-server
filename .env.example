# stdio or http
MCP_TRANSPORT=http
GITHUB_TOKEN=your-gh-token
SCRUM_PLATFORM=github
SCRUM_CONFIG_PATH=.github/scrum/config.yml
PORT=3000
# Listen address — use 0.0.0.0 inside Docker, 127.0.0.1 for local dev
MCP_HOST=127.0.0.1
# WARNING: DEBUG=1 logs tool parameters; TRACE=1 logs raw JSON-RPC messages.
# Secret-bearing parameter values are redacted (***REDACTED***) but key names remain visible.
DEBUG=0
TRACE=0
# CORS: comma-separated allowed origins (empty = permissive, local dev only).
# Set in production, e.g.: ALLOWED_ORIGINS=https://your-client.example.com
ALLOWED_ORIGINS=
# Idle session expiry in ms (default 600000 = 10 min). Set to 0 for no idle expiry.
# SESSION_IDLE_TIMEOUT_MS=600000

# only for side-car containers
SEARXNG_SECRET=change-me
MEMPALACE_USER_NAME=your-name
MEMPALACE_USER_EMAIL=user@email.com