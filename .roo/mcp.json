{
	"mcpServers": {
		"scrum-master": {
			"command": "deno",
			"args": [
				"task",
				"start"
			],
			"env": {
				"MCP_TRANSPORT": "stdio"
			},
			"timeout": 300,
			"alwaysAllow": [
				"scrum_orient",
				"scrum_get_board_health",
				"scrum_find_items",
				"scrum_get_item_detail"
			]
		},
		"memory": {
			"command": "npx",
			"args": [
				"-y",
				"@modelcontextprotocol/server-memory"
			],
			"alwaysAllow": [
				"create_entities",
				"create_relations",
				"add_observations",
				"read_graph",
				"search_nodes",
				"open_nodes"
			],
			"disabled": false
		},
		"mempalace": {
			"command": "mempalace-mcp",
			"args": [],
			"disabled": true,
			"alwaysAllow": [
				"mempalace_search",
				"mempalace_kg_add",
				"mempalace_diary_write"
			]
		},
		"sequentialthinking": {
			"command": "npx",
			"args": [
				"-y",
				"@modelcontextprotocol/server-sequential-thinking"
			],
			"alwaysAllow": [
				"sequentialthinking"
			]
		},
		"searxng": {
			"command": "npx",
			"args": [
				"-y",
				"mcp-searxng"
			],
			"env": {
				"SEARXNG_URL": "http://searxng:8080"
			},
			"alwaysAllow": [
				"searxng_web_search",
				"web_url_read"
			],
			"disabled": false
		},
		"github-mcp-docs": {
			"type": "streamable-http",
			"url": "https://gitmcp.io/github/github-mcp-server",
			"alwaysAllow": [
				"fetch_github_mcp_server_docs",
				"search_github_mcp_server_docs",
				"search_github_mcp_server_code"
			]
		},
		"mcp-ts-sdk": {
			"type": "streamable-http",
			"url": "https://gitmcp.io/modelcontextprotocol/typescript-sdk",
			"alwaysAllow": [
				"fetch_typescript_sdk_docs",
				"search_typescript_sdk_docs",
				"search_typescript_sdk_code"
			]
		},
		"mcp-specs": {
			"type": "streamable-http",
			"url": "https://gitmcp.io/modelcontextprotocol/modelcontextprotocol",
			"alwaysAllow": [
				"fetch_repo_docs",
				"search_repo_docs",
				"fetch_generic_url_content"
			]
		}
	}
}