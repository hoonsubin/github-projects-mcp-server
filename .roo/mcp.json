{
  "mcpServers": {
    "github-projects": {
      "command": "deno",
      "args": ["task", "start"],
      "env": {
        "MCP_TRANSPORT": "stdio"
      },
      "alwaysAllow": [
        "scrum_get_sprint",
        "scrum_get_backlog",
        "scrum_orient",
        "scrum_get_history",
        "scrum_get_story"
      ],
      "timeout": 300
    }
  }
}
