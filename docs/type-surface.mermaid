classDiagram

    namespace TypeScriptTypes {

        class EntityRef:::ts_type {
            +id : string
        }

        class StoryRef:::ts_union_warn {
            <<union>>
            EntityRef
            [ number: number ]
        }

        class ItemListingRef:::ts_type {
            +id : string
            +key : string
        }

        class EpicListing:::ts_interface {
            <<interface>>
            +ref : EpicRef
            +name : string
            +description : string or null
            +priority : string or null
            +status : open or in_progress or done or null
            +story_count : number
            +open_item_count : number
        }

        class DependencyEntry:::ts_interface {
            <<interface>>
            +key : string
            +title : string or null
            +ref : EntityRef
        }

        class ITEM_TYPES:::ts_tuple {
            <<const-tuple>>
            bug
            feature
            tech_debt
            spike
            user_story
            impediment
        }

        class SprintName:::ts_branded {
            <<branded>>
            string & [ readonly _brand: "SprintName" ]
        }

        class SprintRef:::ts_union {
            <<union>>
            current
            next
            null
            SprintName
        }

        class IssueKey:::ts_branded {
            <<branded>>
            string & [ readonly _brand: "IssueKey" ]
        }

        class SprintRiskStance:::ts_union {
            <<union>>
            normal
            monitor
            elevated
        }

        class SprintContext:::ts_interface {
            <<interface>>
            +id : string
            +name : string
            +goal : string or null
            +start_date : string
            +end_date : string
            +duration_days : number
            +days_elapsed : number
            +days_remaining : number
            +time_elapsed_pct : number
            +riskStance : SprintRiskStance
        }

        class EpicSummary:::ts_interface {
            <<interface>>
            +ref : EntityRef
            +name : string
            +description : string or null
            +status : open or in_progress or done or null
            +open_item_count : number
        }

        class SprintRisk:::ts_interface {
            <<interface>>
            +unestimated_count : number
            +blocked_count : number
            +no_assignee_count : number
        }

        class BacklogHealth:::ts_interface_warn {
            <<interface>>
            +readiness : [ by_type: Record~string,[ ready: number, not_ready: number, total: number ]~, overall_pct: number ]
            +sprint_risk : SprintRisk or null
            +impediments : [ orphan_count: number, open_count: number ]
            +ungroomed_count : number
        }

        class BacklogItemListing:::ts_interface_warn {
            <<interface>>
            +ref : ItemListingRef
            +title : string
            +type : string or null
            +status : string or null
            +story_points : number or null
            +priority : string or null
            +assignees : readonly string[]
            +labels : readonly string[]
            +sprint : [ name: string or null, ref: EntityRef ]
            +epic : [ ref: EpicRef, name: string ] or null
            +blocked_by : ReadonlyArray~ItemListingRef~
            +blocks : ReadonlyArray~ItemListingRef~
            +custom_fields : Record~string,string or number or boolean or null~
        }

        class DependencyNode:::ts_interface {
            <<interface>>
            +key : IssueKey
            +title : string or null
            +status : string or null
            +sprint : string or null
            +epic_name : string or null
            +story_points : number or null
            +priority : string or null
            +resolved : boolean
            +blocks : IssueKey[]
            +blocked_by : IssueKey[]
        }

        class StoryBase:::ts_interface_warn {
            <<interface>>
            +ref : EntityRef
            +title : string
            +body : string
            +type : ItemType or null
            +status : string or null
            +sprint : string or null
            +story_points : number or null
            +priority : string or null
            +assignees : readonly string[]
            +labels : readonly string[]
            +created_at : string
            +updated_at : string
            +blocked_by : readonly DependencyEntry[]
            +kind : string or null
            +key : string or null
            +url : string or null
            +epic : [ ref: EpicRef, name: string ] or null
        }

        class IterationEntry:::ts_interface {
            <<interface>>
            +id : string
            +title : string
            +startDate : string
            +duration : number
        }

        class BurndownResponse:::ts_interface {
            <<interface>>
            +sprint : BurndownSprintMeta
            +data_source : audit_log or issue_close_proxy
            +warning : string opt
            +series : readonly BurndownDayPoint[]
            +ideal : readonly IdealDayPoint[]
            +stories : readonly BurndownStory[]
        }

        class BurndownSprintMeta:::ts_interface {
            <<interface>>
            +name : string
            +start_date : string
            +end_date : string
            +duration_days : number
            +days_remaining : number
        }

        class BurndownDayPoint:::ts_interface {
            <<interface>>
            +date : string
            +remaining_points : number
            +completed_points : number
        }

        class IdealDayPoint:::ts_interface {
            <<interface>>
            +date : string
            +remaining_points : number
        }

        class BurndownStory:::ts_interface {
            <<interface>>
            +number : number
            +title : string
            +points : number
            +status : string or null
            +completed_at : string or null
        }

        class ItemSearchResult:::ts_interface_warn {
            <<interface>>
            +items : BacklogItemListing[]
            +total_count : number
            +scope_summary : [ sprint_count: number or null, backlog_count: number or null ]
            +dependency_map : DependencyMap or null
        }

        class SprintTotals:::ts_union_warn {
            <<union>>
            [ kind: active, by_status: Record~string,number~, story_points: number ]
            [ kind: completed, by_status: Record~string,number~, story_points: number, committed_points: number, completed_points: number ]
        }

        class SprintSnapshot:::ts_interface_warn {
            <<interface>>
            +sprint : [ name: string, start_date: string, end_date: string, duration_days: number, days_remaining: number ]
            +items : readonly BacklogItemListing[]
            +total_count : number
            +totals : SprintTotals
        }

        class AnalyticsResult:::ts_interface {
            <<interface>>
            +burndown : BurndownResponse or null
            +history : SprintSnapshot[] or null
            +window : number
        }

        class StoryComment:::ts_interface {
            <<interface>>
            +author : string
            +body : string
            +created_at : string
            +url : string
        }

        class LinkedArtifact:::ts_interface {
            <<interface>>
            +number : number
            +title : string
            +url : string
            +state : string
            +is_draft : boolean
        }

        class ItemDetailResult:::ts_interface {
            <<interface>>
            +story : Story
            +comments : readonly StoryComment[] or null
            +linked_artifacts : readonly LinkedArtifact[] or null
            +acceptance_criteria : readonly string[]
        }

        class PartialResult:::ts_interface {
            <<interface>>
            +warnings : readonly string[]
        }

        class UseCaseResult:::ts_interface {
            <<interface>>
            +data : T
        }

        class OrientResult:::ts_interface_warn {
            <<interface>>
            +platform_state : [ fields: [ status: [ exists: boolean, options: readonly string[], missing_options: readonly string[] ], sprint: [ exists: boolean ], story_points: [ exists: boolean ], priority: [ exists: boolean, options: readonly string[], missing_options: readonly string[] ], type_field: [ exists: boolean, configured: boolean ] ], missing_options: readonly string[], labels: [ existing: readonly string[], expected: readonly string[], missing: readonly string[] ], iterations: [ active: SprintContext or null, next: SprintContext or null, completed_count: number ], epics: [ active: readonly EpicSummary[], total_count: number ], template_uris: TemplateUriMap or null, deadline_field: string or null ]
            +vocabulary : [ status: Record~string,string~ or null, priority: Record~string,string~ or null, type: Record~string,string~ or null, story_points: [ scale: string or null, values: readonly number[] or null ], sprint: [ duration_days: number or null, velocity_window: number, length_weeks: number or null ], team: readonly [ readonly name: string; readonly role: "scrum_master" | "product_owner" | "developer"; readonly contact?: string; ][] or null, dor: readonly string[] or null, dod: readonly string[] or null, autonomy: [ require_confirmation_above_n_items: number or null ] or null ]
        }

    }

    namespace ZodSchemas {

        class GetItemDetailArgs:::zod_args {
            <<Arguments>>
            +ref : StoryRef
        }

        class FindItemsArgs:::zod_args {
            <<Arguments>>
            +scope : backlog or sprint or all opt
            +keys : string[] opt
            +search : string opt
            +types : string[] opt
            +statuses : string[] opt
            +priority : string opt
            +epic_id : string opt
            +labels : string[] opt
            +assignee : string opt
            +estimated : boolean opt
            +sprint_ref : SprintRef opt
            +include_dependencies : boolean opt
            +limit : number opt
        }

        class GetAnalyticsArgs:::zod_args {
            <<Arguments>>
            +view : burndown or history or both opt
            +sprint_ref : SprintRef opt
            +history_window : number opt
        }

        class GetBoardHealthArgs:::zod_args {
            <<Arguments>>
            +sprint_scope : string opt
        }

        class CreateStoryArgs:::zod_args {
            <<Arguments>>
            +title : string
            +body : string
            +type : StoryType
            +priority : string opt
            +story_points : number opt
            +labels : string[] opt
            +epic : EpicRef opt
            +assignees : string[] opt
            +sprint : SprintRef opt
        }

        class UpdateStoryArgs:::zod_args {
            <<Arguments>>
            +ref : StoryRef
            +title : string opt
            +body : string opt
            +labels : string[] opt
            +assignees : string[] opt
            +epic : EpicRef or null opt
            +comment : string opt
            +blocked_by : StoryRef[] or null opt
        }

        class SetFieldArgs:::zod_args {
            <<Arguments>>
            +ref : StoryRef
            +field : ScrumField
            +value : string or number or SprintRef or null
        }

        class PlanSprintArgs:::zod_args {
            <<Arguments>>
            +sprint : SprintRef
            +stories : StoryRef[]
            +replace : boolean
            +goal : string opt
        }

        class LogImpedimentArgs:::zod_args {
            <<Arguments>>
            +description : string
            +affects : object or object opt
            +raised_by : string opt
            +priority : string opt
        }

        class UpdateImpedimentArgs:::zod_args {
            <<Arguments>>
            +ref : object
            +status : open or in_progress or resolved
            +resolution_notes : string opt
        }

        class AddVocabularyArgs:::zod_args {
            <<Arguments>>
            +kind : status_option or priority_option or label
            +value : string
        }

        class GraphQLQueryArgs:::zod_args {
            <<Arguments>>
            +query : string
            +variables : Record~string,unknown~ opt
        }

    }

