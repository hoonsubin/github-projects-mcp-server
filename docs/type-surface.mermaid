    StoryRef --> EntityRef : entityref-variant
    DependencyEntry --> EntityRef : ref
    SprintRef --> SprintName : sprintname-variant
    SprintContext --> SprintRiskStance : riskStance
    EpicSummary --> EntityRef : ref
    BacklogHealth --> SprintRisk : sprint_risk
    BacklogItemListing --> ItemListingRef : ref
    BacklogItemListing --> EntityRef : sprint
    DependencyNode --> IssueKey : key
    StoryBase --> EntityRef : ref
    BurndownResponse --> BurndownSprintMeta : sprint
    ItemSearchResult --> BacklogItemListing : items
    SprintSnapshot --> SprintTotals : totals
    AnalyticsResult --> BurndownResponse : burndown
    AnalyticsResult --> SprintSnapshot : history
    UseCaseResult --|> PartialResult : extends
    OrientResult --|> PartialResult : extends
    OrientResult --> SprintContext : platform_state
    GetItemDetailArgs --> StoryRef : ref
    FindItemsArgs --> SprintRef : sprint_ref
    GetAnalyticsArgs --> SprintRef : sprint_ref
    CreateStoryArgs --> SprintRef : sprint
    UpdateStoryArgs --> StoryRef : ref
    SetFieldArgs --> StoryRef : ref
    SetFieldArgs --> SprintRef : value
    PlanSprintArgs --> SprintRef : sprint
    PlanSprintArgs --> StoryRef : stories
    scrum_get_item_detail ..> GetItemDetailArgs : accepts
    scrum_find_items ..> FindItemsArgs : accepts
    scrum_get_analytics ..> GetAnalyticsArgs : accepts
    scrum_get_board_health ..> GetBoardHealthArgs : accepts
    scrum_add_vocabulary ..> AddVocabularyArgs : accepts
    scrum_set_field ..> SetFieldArgs : accepts
    scrum_update_story ..> UpdateStoryArgs : accepts
    scrum_create_story ..> CreateStoryArgs : accepts
    scrum_plan_sprint ..> PlanSprintArgs : accepts
    scrum_log_impediment ..> LogImpedimentArgs : accepts
    scrum_update_impediment ..> UpdateImpedimentArgs : accepts

