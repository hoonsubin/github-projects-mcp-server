{
  "tasks": {
    "dev": "deno run --env-file --allow-env --watch --allow-net --allow-read src/server.ts",
    "start": "deno run --env-file --allow-env --allow-net --allow-read src/server.ts --config .github/scrum/config.yml",
    "inspector": "deno run --allow-env --allow-net --allow-read --allow-run src/server.ts",
    "diagram-gen": "deno run --allow-read --allow-env --allow-write scripts/generate-project-diagram.ts --output ./docs --src ./src --include-external",
    "test": "GITHUB_TOKEN=test-token deno test --allow-env=DEBUG,GITHUB_TOKEN,NODE_ENV --allow-net --allow-read src/",
    "compile": "deno compile --allow-env --allow-net --allow-read --output mcp-server src/server.ts",
    "compile:mac:arm64": "deno compile --target aarch64-apple-darwin   --allow-env --allow-net --allow-read --output dist/mcp-server-mac-arm64   src/server.ts",
    "compile:mac:x64": "deno compile --target x86_64-apple-darwin    --allow-env --allow-net --allow-read --output dist/mcp-server-mac-x64     src/server.ts",
    "compile:linux:x64": "deno compile --target x86_64-unknown-linux-gnu --allow-env --allow-net --allow-read --output dist/mcp-server-linux-x64  src/server.ts",
    "compile:linux:arm64": "deno compile --target aarch64-unknown-linux-gnu --allow-env --allow-net --allow-read --output dist/mcp-server-linux-arm64  src/server.ts",
    "compile:win": "deno compile --target x86_64-pc-windows-msvc  --allow-env --allow-net --allow-read --output dist/mcp-server-win.exe     src/server.ts",
    "compile:all": "deno task compile:mac:arm64 && deno task compile:mac:x64 && deno task compile:linux:x64 && deno task compile:linux:arm64 && deno task compile:win && deno task bundle:node && deno task bundle:mcpb",
    "bundle:node": "deno run --allow-read --allow-write --allow-env --allow-net --allow-run scripts/bundle-node.ts",
    "bundle:mcpb": "deno run --allow-read --allow-write --allow-env --allow-run scripts/bundle-mcpb.ts",
    "capture-fixtures": "deno run --allow-env=GITHUB_TOKEN,DEBUG,NODE_ENV --allow-net --allow-read --allow-write scripts/capture-test-fixtures.ts --config .github/scrum/config.yml"
  },
  "imports": {
    "@hono/node-server": "npm:@hono/node-server@^1.19.9",
    "@modelcontextprotocol/inspector": "npm:@modelcontextprotocol/inspector@^0.21.2",
    "@modelcontextprotocol/sdk": "npm:@modelcontextprotocol/sdk@^1.29.0",
    "@std/path": "jsr:@std/path@^1.1.4",
    "esbuild": "npm:esbuild@^0.28.0",
    "graphql": "npm:graphql@^16.13.2",
    "zod": "npm:zod@^4.3.6",
    "typescript": "npm:typescript@^5.9.3",
    "@std/assert": "jsr:@std/assert@1",
    "@std/cli": "jsr:@std/cli@^1.0.29",
    "@std/yaml": "jsr:@std/yaml@^1.1.0",
    "@std/testing": "jsr:@std/testing@^1.0.0"
  },
  "exclude": [
    "dist/",
    ".roo/",
    "docs/",
    "**/*.js",
    "**/*.mjs"
  ],
  "compilerOptions": {
    "lib": [
      "ES2022",
      "deno.ns",
      "dom"
    ],
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "skipLibCheck": true
  },
  "unstable": [
    "raw-imports"
  ],
  "compile": {
    "exclude": [
      "**/*.test.ts",
      "**/__fixtures__/"
    ]
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": false,
    "semiColons": true,
    "proseWrap": "never"
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ],
      "include": [
        "no-unused-vars",
        "no-explicit-any",
        "eqeqeq",
        "no-func-assign",
        "no-dupe-else-if",
        "no-invalid-triple-slash-reference"
      ]
    }
  }
}
