{
  "tasks": {
    "dev": "deno run --env-file --allow-env --watch --allow-net --allow-read src/index.ts",
    "start": "deno run --env-file --allow-env --allow-net --allow-read src/index.ts",
    "inspector": "deno run --allow-env --allow-net --allow-read --allow-run src/index.ts",
    "diagram-gen": "deno run --allow-read --allow-env --allow-write scripts/generate-project-diagram.ts --output ./docs/proj-diagram.md --src ./src --include-external",
    "test": "GITHUB_TOKEN=test-token deno test --allow-env=DEBUG,GITHUB_TOKEN --allow-net src/"
  },
  "imports": {
    "@modelcontextprotocol/inspector": "npm:@modelcontextprotocol/inspector@^0.21.2",
    "@modelcontextprotocol/sdk": "npm:@modelcontextprotocol/sdk@^1.29.0",
    "@std/path": "jsr:@std/path@^1.1.4",
    "@types/express": "npm:@types/express@^5.0.6",
    "express": "npm:express@^5.2.1",
    "graphql": "npm:graphql@^16.13.2",
    "zod": "npm:zod@^4.3.6",
    "typescript": "npm:typescript@^5.9.3",
    "@std/assert": "jsr:@std/assert@1",
    "@std/cli": "jsr:@std/cli@^1.0.29",
    "@std/yaml": "jsr:@std/yaml@^1.1.0"
  },
  "compilerOptions": {
    "lib": [
      "ES2022",
      "deno.ns",
      "dom"
    ],
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "skipLibCheck": true
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": false,
    "semiColons": true,
    "proseWrap": "never",
    "exclude": [
      ".roo/"
    ]
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ],
      "include": [
        "no-unused-vars",
        "no-explicit-any",
        "eqeqeq",
        "no-func-assign",
        "no-dupe-else-if",
        "no-invalid-triple-slash-reference"
      ]
    }
  }
}
